{
  "openapi": "3.1.0",
  "info": {
    "title": "upnext",
    "version": "0.1.0"
  },
  "paths": {
    "/api/config": {
      "get": {
        "summary": "Config",
        "operationId": "config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          }
        }
      }
    },
    "/api/titles": {
      "get": {
        "summary": "List Titles",
        "operationId": "list_titles_api_titles_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Status"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TitleSummary"
                  },
                  "title": "Response List Titles Api Titles Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/titles/{title_id}": {
      "get": {
        "summary": "Get Title",
        "operationId": "get_title_api_titles__title_id__get",
        "parameters": [
          {
            "name": "title_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMaximum": 9223372036854775808,
              "exclusiveMinimum": 0,
              "title": "Title Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TitleDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/titles/{title_id}/status": {
      "put": {
        "summary": "Set Status",
        "description": "File a title under a status. Kept over whatever a later re-import says.",
        "operationId": "set_status_api_titles__title_id__status_put",
        "parameters": [
          {
            "name": "title_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMaximum": 9223372036854775808,
              "exclusiveMinimum": 0,
              "title": "Title Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusChange"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/up-next": {
      "get": {
        "summary": "Up Next",
        "operationId": "up_next_api_up_next_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UpNextItem"
                  },
                  "type": "array",
                  "title": "Response Up Next Api Up Next Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/timeline": {
      "get": {
        "summary": "Timeline",
        "operationId": "timeline_api_timeline_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Timeline"
                }
              }
            }
          }
        }
      }
    },
    "/api/episodes/{episode_id}/watch": {
      "post": {
        "summary": "Mark Watched",
        "description": "Record a viewing now. Stamped in UTC, in the same shape imported timestamps take.",
        "operationId": "mark_watched_api_episodes__episode_id__watch_post",
        "parameters": [
          {
            "name": "episode_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMaximum": 9223372036854775808,
              "exclusiveMinimum": 0,
              "title": "Episode Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Unmark Watched",
        "description": "Remove the latest viewing marked in upnext. Imported history stays.",
        "operationId": "unmark_watched_api_episodes__episode_id__watch_delete",
        "parameters": [
          {
            "name": "episode_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMaximum": 9223372036854775808,
              "exclusiveMinimum": 0,
              "title": "Episode Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Stats",
        "operationId": "stats_api_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Config": {
        "properties": {
          "image_base": {
            "type": "string",
            "title": "Image Base",
            "description": "TMDB's artwork CDN. The library stores paths, so the client joins this to\na `poster_path` with the size it wants \u2014 a render-time decision, and\ntherefore the client's."
          }
        },
        "type": "object",
        "required": [
          "image_base"
        ],
        "title": "Config",
        "description": "What the client needs to know about this installation to render at all."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Stats": {
        "properties": {
          "watches": {
            "type": "integer",
            "title": "Watches"
          },
          "distinct_episodes": {
            "type": "integer",
            "title": "Distinct Episodes",
            "description": "History, not progress: matched and unmatched, specials included."
          },
          "titles_watched": {
            "type": "integer",
            "title": "Titles Watched"
          },
          "first_watch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Watch"
          },
          "last_watch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Watch"
          },
          "known_minutes": {
            "type": "integer",
            "title": "Known Minutes",
            "description": "A floor, not a total: nothing has a runtime before enrichment."
          },
          "by_status": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Status"
            },
            "type": "object",
            "title": "By Status"
          }
        },
        "type": "object",
        "required": [
          "watches",
          "distinct_episodes",
          "titles_watched",
          "first_watch",
          "last_watch",
          "known_minutes",
          "by_status"
        ],
        "title": "Stats"
      },
      "Status": {
        "type": "string",
        "enum": [
          "watching",
          "watch_later",
          "watchlist",
          "completed",
          "stopped"
        ],
        "title": "Status",
        "description": "Where a title sits for the user.\n\nNo \"unwatched\": a title with no relationship to the user has no state row\nat all. Declared in the order a library is read \u2014 what you are on, then\nthe rest \u2014 which is the order every count of them is listed in."
      },
      "StatusChange": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusChange"
      },
      "Timeline": {
        "properties": {
          "today": {
            "type": "string",
            "title": "Today",
            "description": "Today in UTC. Sent rather than left to the client, which would otherwise\nhave to agree with the server about when today is \u2014 and so which episodes\nare out to be marked."
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/TimelineItem"
            },
            "type": "array",
            "title": "Episodes"
          }
        },
        "type": "object",
        "required": [
          "today",
          "episodes"
        ],
        "title": "Timeline"
      },
      "TimelineItem": {
        "properties": {
          "title_id": {
            "type": "integer",
            "title": "Title Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "poster_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Path"
          },
          "episode_id": {
            "type": "integer",
            "title": "Episode Id"
          },
          "season_number": {
            "type": "integer",
            "title": "Season Number"
          },
          "episode_number": {
            "type": "integer",
            "title": "Episode Number"
          },
          "episode_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode Name"
          },
          "air_date": {
            "type": "string",
            "title": "Air Date"
          }
        },
        "type": "object",
        "required": [
          "title_id",
          "name",
          "poster_path",
          "episode_id",
          "season_number",
          "episode_number",
          "episode_name",
          "air_date"
        ],
        "title": "TimelineItem",
        "description": "One unwatched episode, recently out or still to come, of a show with watch history."
      },
      "TitleDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "poster_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Path"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_episodes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Episodes",
            "description": "What the catalog says the whole run is, specials excluded."
          },
          "episodes_watched": {
            "type": "integer",
            "title": "Episodes Watched",
            "description": "Distinct episodes watched that TMDB's list contains, specials excluded.\nThe figure `total_episodes` is comparable to."
          },
          "unmatched_watched": {
            "type": "integer",
            "title": "Unmatched Watched",
            "description": "Distinct episodes watched that TMDB's list does not contain, specials\nincluded, counted by what the export called them. Real viewings of something TMDB numbers\ndifferently \u2014 the two together are the whole history."
          },
          "enriched_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enriched At",
            "description": "Null until TMDB has answered for this title, which is what tells \"TMDB\ndoes not list these\" apart from \"there is no list yet\"."
          },
          "overview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overview"
          },
          "air_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Air Status",
            "description": "The show's own status at TMDB (\"Ended\", \"Returning Series\"), not the user's."
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating",
            "description": "Out of 10. A TV Time rating out of 5 is doubled on import."
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/TitleEpisode"
            },
            "type": "array",
            "title": "Episodes",
            "default": []
          },
          "unmatched": {
            "items": {
              "$ref": "#/components/schemas/UnmatchedViewing"
            },
            "type": "array",
            "title": "Unmatched",
            "default": []
          },
          "today": {
            "type": "string",
            "title": "Today",
            "description": "Today in UTC, so the client can tell an episode that is out \u2014 and can be\nmarked \u2014 from one that is not, without its own clock.",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "year",
          "poster_path",
          "status",
          "total_episodes",
          "episodes_watched",
          "unmatched_watched",
          "enriched_at",
          "overview",
          "air_status",
          "rating"
        ],
        "title": "TitleDetail"
      },
      "TitleEpisode": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "season_number": {
            "type": "integer",
            "title": "Season Number"
          },
          "episode_number": {
            "type": "integer",
            "title": "Episode Number"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "air_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Air Date"
          },
          "watch_count": {
            "type": "integer",
            "title": "Watch Count",
            "description": "Viewings, so a rewatch is 2 rather than collapsing into \"seen\"."
          },
          "marked_here": {
            "type": "boolean",
            "title": "Marked Here",
            "description": "Whether a viewing was marked in upnext, and so can be unmarked."
          }
        },
        "type": "object",
        "required": [
          "id",
          "season_number",
          "episode_number",
          "name",
          "air_date",
          "watch_count",
          "marked_here"
        ],
        "title": "TitleEpisode"
      },
      "TitleSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "poster_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Path"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_episodes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Episodes",
            "description": "What the catalog says the whole run is, specials excluded."
          },
          "episodes_watched": {
            "type": "integer",
            "title": "Episodes Watched",
            "description": "Distinct episodes watched that TMDB's list contains, specials excluded.\nThe figure `total_episodes` is comparable to."
          },
          "unmatched_watched": {
            "type": "integer",
            "title": "Unmatched Watched",
            "description": "Distinct episodes watched that TMDB's list does not contain, specials\nincluded, counted by what the export called them. Real viewings of something TMDB numbers\ndifferently \u2014 the two together are the whole history."
          },
          "enriched_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enriched At",
            "description": "Null until TMDB has answered for this title, which is what tells \"TMDB\ndoes not list these\" apart from \"there is no list yet\"."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "year",
          "poster_path",
          "status",
          "total_episodes",
          "episodes_watched",
          "unmatched_watched",
          "enriched_at"
        ],
        "title": "TitleSummary",
        "description": "A title as a shelf sees it: enough for a poster and its progress."
      },
      "UnmatchedViewing": {
        "properties": {
          "season_number": {
            "type": "integer",
            "title": "Season Number"
          },
          "episode_number": {
            "type": "integer",
            "title": "Episode Number"
          },
          "watch_count": {
            "type": "integer",
            "title": "Watch Count"
          },
          "last_watched_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Watched At"
          }
        },
        "type": "object",
        "required": [
          "season_number",
          "episode_number",
          "watch_count",
          "last_watched_at"
        ],
        "title": "UnmatchedViewing",
        "description": "Viewings of an episode TMDB's list does not contain, in the export's numbering.\n\nRendered apart from the episode list rather than mixed into it: they are\nnot episodes of this show as TMDB understands it."
      },
      "UpNextItem": {
        "properties": {
          "title_id": {
            "type": "integer",
            "title": "Title Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "poster_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Path"
          },
          "episode_id": {
            "type": "integer",
            "title": "Episode Id"
          },
          "season_number": {
            "type": "integer",
            "title": "Season Number"
          },
          "episode_number": {
            "type": "integer",
            "title": "Episode Number"
          },
          "episode_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode Name"
          },
          "last_watched_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Watched At"
          },
          "air_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Air Date",
            "description": "When the episode aired, for sorting by the newest; null if TMDB has no date."
          }
        },
        "type": "object",
        "required": [
          "title_id",
          "name",
          "poster_path",
          "episode_id",
          "season_number",
          "episode_number",
          "episode_name",
          "last_watched_at",
          "air_date"
        ],
        "title": "UpNextItem",
        "description": "The next unwatched episode of one show in progress."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
