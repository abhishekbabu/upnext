# Copy to .env and fill in. This file is gitignored and is not synced between
# machines: paste the key from your password manager on each new one.
#
# Everything here has a working default except the TMDB key. `upnext import`
# and the API run fine without it; `upnext enrich` is the one command that
# needs it, and it says so rather than failing halfway.

# The Movie Database, the catalog upnext resolves shows against.
# Sign up at https://www.themoviedb.org/signup, then request a key at
# https://www.themoviedb.org/settings/api — choose "Developer", which is free
# and needs no card. Copy the value labelled "API Key", the v3 one.
UPNEXT_TMDB_API_KEY=

# Optional. Every one below already has this value as its default, so leave
# them commented unless you are changing one.
# UPNEXT_DB_PATH=~/.upnext/library.db
# UPNEXT_TMDB_LANGUAGE=en-US
# UPNEXT_HOST=127.0.0.1
# UPNEXT_PORT=8000
