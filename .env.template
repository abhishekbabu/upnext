# Copy to .env and fill in. Everything here has a working default except the
# TMDB key, which only `upnext enrich` needs — import and browsing work without it.

# https://www.themoviedb.org/settings/api — free, personal use, no card.
UPNEXT_TMDB_API_KEY=

# Where the library lives. Defaults to ~/.upnext/library.db.
# UPNEXT_DB_PATH=

# UPNEXT_TMDB_LANGUAGE=en-US
# UPNEXT_HOST=127.0.0.1
# UPNEXT_PORT=8000
